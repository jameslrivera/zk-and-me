# Solana RPC. The public devnet endpoint rate-limits; swap in a provider URL if posts start failing with 429.
VITE_RPC_URL=https://api.devnet.solana.com

# Wallet that called register_lab (run `npm run register-lab` once after deploying).
VITE_LAB_AUTHORITY=

# Segments each identity publishes. 16 keeps the demo fast and cheap; 128 is the whole genome.
VITE_PUBLISH_COUNT=16

# DEVNET ONLY. Secret key (JSON array) of a funded wallet that tops up demo burners.
# Leave empty to fall back to airdrops. Never put a mainnet key here — it ships to the browser.
VITE_DEMO_FUNDER_SECRET=
